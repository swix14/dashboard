PORT=4000
NODE_ENV=development

# Configuración MySQL (XAMPP / Producción)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jardines_vtf

# Base de datos relacional Prisma (opcional)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vtf_gestion?schema=public"

# Seguridad y Autenticación
JWT_SECRET="vtf-gestion-super-secret-key-2026-production-ready"
JWT_EXPIRES_IN="8h"

# CORS y almacenamiento de archivos
CORS_ORIGIN="http://localhost:5173"
UPLOADS_DIR="./uploads"
