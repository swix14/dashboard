PORT=4000
NODE_ENV=development

# Configuración Base de Datos MySQL (XAMPP / Producción)
# En cPanel la base Y el usuario llevan el prefijo de la cuenta. Ejemplo en vtftemuco.cl:
#   DB_NAME=vtftemuc_jardines_vtf
#   DB_USER=vtftemuc_vtf
# Copiar los nombres tal como aparecen en cPanel > Bases de datos MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jardines_vtf

# Datos de prueba en memoria si MySQL no responde (por defecto: sí en desarrollo, NO en producción).
# En producción nunca activarlo: mostraría datos falsos y no guardaría nada.
# ALLOW_MEMORY_FALLBACK=false

# Seguridad y Autenticación
JWT_SECRET="vtf-gestion-super-secret-key-2026-production-ready"
JWT_EXPIRES_IN="8h"

# CORS y almacenamiento de archivos
CORS_ORIGIN="http://localhost:5173"
UPLOADS_DIR="./uploads"
